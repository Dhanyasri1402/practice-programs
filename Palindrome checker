#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

bool isPalindrome(string str) {
    string reversedStr = str;
    reverse(reversedStr.begin(), reversedStr.end());
    return str == reversedStr;
}

int main() {
    string text = "racecar";
    if (isPalindrome(text)) {
        cout << text << " is a palindrome." << endl;
    } else {
        cout << text << " is not a palindrome." << endl;
    }
    return 0;
}
